		{
			"name": "Update Campaign <race_condition>",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "096190c0-e0ef-4e13-a333-c7ac9aa2255f",
						"exec": [
							"const baseUrl = \"http://localhost:8080\";\r",
							"const id      = pm.environment.get(\"new_campaign_id\");\r",
							"const version = pm.environment.get(\"campaign_version\");\r",
							"\r",
							"const url  = `${baseUrl}/api/campaigns/${id}`;\r",
							"const body = JSON.stringify({\r",
							"  id, version,\r",
							"  name: \"Test Campaign\",\r",
							"  description: \"A test campaign\",\r",
							"  start_date: \"2026-06-01T00:00:00\",\r",
							"  end_date: \"2026-06-30T23:59:59\",\r",
							"  budget: 500.0,\r",
							"  status: \"ACTIVE\",\r",
							"  offer_ids: null\r",
							"});\r",
							"\r",
							"console.log(\"baseUrl:\", baseUrl);\r",
							"console.log(\"id:\", id);\r",
							"console.log(\"version:\", version);\r",
							"console.log(\"url:\", url);\r",
							"console.log(\"body:\", body);\r",
							"\r",
							"function fire() {\r",
							"  pm.sendRequest({\r",
							"    url, method: 'PUT',\r",
							"    header: {\r",
							"      'Content-Type': 'application/json',\r",
							"      'X-Debug-Slow': 'true' // optional, server delay\r",
							"    },\r",
							"    body: { mode: 'raw', raw: body }\r",
							"  }, (err, res) => {\r",
							"    console.log('PUT status:', res && res.code, 'err:', err);\r",
							"  });\r",
							"}\r",
							"fire();\r",
							"fire();\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
