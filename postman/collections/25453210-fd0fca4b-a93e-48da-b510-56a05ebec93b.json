		{
			"name": "Update Campaign <users_1/2/3 race_condition> :: ERROR_CONFLICT",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "096190c0-e0ef-4e13-a333-c7ac9aa2255f",
						"exec": [
							"// ---------- config ----------\r",
							"const baseUrl = \"http://localhost:8080\";\r",
							"const id      = pm.environment.get(\"new_campaign_id\");\r",
							"const version = pm.environment.get(\"campaign_version\");\r",
							"const nextVersion = parseInt(version) + 1;\r",
							"console.log(\"version:\", version);\r",
							"console.log(\"nextVersion:\", nextVersion);\r",
							"\r",
							"const url  = `${baseUrl}/api/campaigns/${id}`;\r",
							"const headers = {\r",
							"  \"Content-Type\": \"application/json\",\r",
							"  \"X-Debug-Slow\": \"true\"\r",
							"};\r",
							"\r",
							"const bodies = [\r",
							"  {\r",
							"    label: \"A_version:\"+version,\r",
							"    body: {\r",
							"      id, version,\r",
							"      name: \"Test Campaign\",\r",
							"      description: \"A test campaign\",\r",
							"      start_date: \"2026-06-01T00:00:00\",\r",
							"      end_date: \"2026-06-30T23:59:59\",\r",
							"      budget: 500.0,\r",
							"      status: \"ACTIVE\",\r",
							"      offer_ids: null\r",
							"    }\r",
							"  },\r",
							"  {\r",
							"    label: \"B_version:\"+version,\r",
							"    body: {\r",
							"      id, version,\r",
							"      name: \"Test Campaign\",\r",
							"      description: \"A test campaign\",\r",
							"      start_date: \"2026-06-01T00:00:00\",\r",
							"      end_date: \"2026-06-30T23:59:59\",\r",
							"      budget: 500.0,\r",
							"      status: \"ACTIVE\",\r",
							"      offer_ids: null\r",
							"    }\r",
							"  },\r",
							"  {\r",
							"    label: \"C_version:\"+nextVersion,\r",
							"    body: {\r",
							"      id, version: nextVersion,\r",
							"      name: \"Test Campaign\",\r",
							"      description: \"A test campaign\",\r",
							"      start_date: \"2026-06-01T00:00:00\",\r",
							"      end_date: \"2026-06-30T23:59:59\",\r",
							"      budget: 200.0,\r",
							"      status: \"ACTIVE\",\r",
							"      offer_ids: null\r",
							"    }\r",
							"  }\r",
							"];\r",
							"\r",
							"const results = [];\r",
							"function sendPut(label, body) {\r",
							"  pm.sendRequest({\r",
							"    url, method: \"PUT\",\r",
							"    header: headers,\r",
							"    body: { mode: \"raw\", raw: JSON.stringify(body) }\r",
							"  }, (err, res) => {\r",
							"    results.push({\r",
							"      label,\r",
							"      code:  res ? res.code : \"ERR\",\r",
							"      status:res ? res.status : String(err),\r",
							"      time:  res ? res.responseTime : null,\r",
							"      body:  res ? res.text() : \"\"\r",
							"    });\r",
							"\r",
							"    pm.test(`Request ${label} sent`, () => pm.expect(err).to.be.null);\r",
							"    if (res) pm.test(`Request ${label} status`, () =>\r",
							"      pm.expect([200, 201, 204, 409]).to.include(res.code)\r",
							"    );\r",
							"\r",
							"    if (results.length === 3) {\r",
							"      const template = `\r",
							"        <style>\r",
							"          body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial}\r",
							"          table{border-collapse:collapse;margin-top:6px}\r",
							"          th,td{border:1px solid #ddd;padding:6px 8px;font-size:13px}\r",
							"          th{background:#f6f6f6;text-align:left}\r",
							"          pre{background:#fafafa;border:1px solid #eee;padding:8px;white-space:pre-wrap}\r",
							"        </style>\r",
							"        <h3>CAS Race Results</h3>\r",
							"        <table>\r",
							"          <tr><th>Request</th><th>Status</th><th>Code</th><th>Time (ms)</th></tr>\r",
							"          {{#each results}}\r",
							"            <tr><td>{{label}}</td><td>{{status}}</td><td>{{code}}</td><td>{{time}}</td></tr>\r",
							"          {{/each}}\r",
							"        </table>\r",
							"        <h4>Bodies</h4>\r",
							"        {{#each results}}\r",
							"          <h5>{{label}} — {{code}} {{status}}</h5>\r",
							"          <pre>{{body}}</pre>\r",
							"        {{/each}}\r",
							"      `;\r",
							"      pm.visualizer.set(template, { results });\r",
							"    }\r",
							"  });\r",
							"}\r",
							"\r",
							"sendPut(bodies[0].label, bodies[0].body);\r",
							"sendPut(bodies[1].label, bodies[1].body);\r",
							"setTimeout(() => sendPut(bodies[2].label, bodies[2].body), 1000);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
