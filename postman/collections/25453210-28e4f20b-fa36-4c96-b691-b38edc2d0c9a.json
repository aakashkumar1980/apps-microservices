						{
							"name": "<verification:status_CANCELLED> Get Offers By Campaign Id",
							"event": [
								{
									"listen": "test",
									"script": {
										"id": "06ca8d85-d51b-424e-8c1a-2c4818bcdb58",
										"exec": [
											"// Parse the JSON response\r",
											"let jsonData = pm.response.json();\r",
											"\r",
											"// Extract offer_id values\r",
											"let offerIds = jsonData.map(item => item.id);\r",
											"// Save to environment variable as JSON string\r",
											"pm.environment.set(\"linked_offers\", JSON.stringify(offerIds));\r",
											"console.info(\"linked_offers:\", pm.environment.get(\"linked_offers\"));\r",
											"\r",
											"\r",
											"// Extract merchant_id values\r",
											"let merchantIds = jsonData.map(item => item.data.merchant_id);\r",
											"// Remove duplicates using Set\r",
											"let uniqueMerchantIds = [...new Set(merchantIds)];\r",
											"// Save to environment variable as JSON string\r",
											"pm.environment.set(\"merchant_ids\", JSON.stringify(uniqueMerchantIds));\r",
											"console.info(\"merchant_ids:\", pm.environment.get(\"merchant_ids\"));"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
