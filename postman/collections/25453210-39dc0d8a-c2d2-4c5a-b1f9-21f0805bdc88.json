					"script": {
						"id": "fb17a9a3-d179-4053-a113-b78ef7f600cd",
						"exec": [
							"// Fixed ReferenceError by defining new_campaign_id\r",
							"var locationHeader = pm.response.headers.get('Location');\r",
							"var newId = locationHeader.substring(locationHeader.lastIndexOf('/') + 1);\r",
							"pm.environment.set('new_campaign_id', newId);\r",
							"console.log(\"new_campaign_id: \", pm.environment.get('new_campaign_id'));\r",
							""
