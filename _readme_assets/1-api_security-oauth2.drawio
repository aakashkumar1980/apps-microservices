        <mxCell id="okta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#d6b656;verticalAlign=top;spacingLeft=10;spacingRight=10;align=left;spacingTop=10;fontSize=12;fontFamily=Times New Roman;" value="&lt;b&gt;🔐 Okta&lt;/b&gt;&lt;br&gt;&lt;i&gt;OAuth2 / OIDC&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Scopes:&lt;/b&gt;&lt;br&gt;• &lt;span style=&quot;background-color: light-dark(rgb(151, 208, 119), rgb(24, 24, 0));&quot;&gt;campaigns:read&lt;/span&gt;&lt;br&gt;• &lt;span style=&quot;background-color: light-dark(rgb(151, 208, 119), rgb(24, 24, 0));&quot;&gt;campaigns:write&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Grant Types:&lt;/b&gt;&lt;br&gt;• client_credentials &lt;i&gt;(M2M)&lt;/i&gt;&lt;br&gt;• authorization_code &lt;i&gt;(UI Apps)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;background-color: rgb(204, 204, 204); padding: 5px;&quot;&gt;&lt;b&gt;M2M Connection:&lt;/b&gt;&lt;br&gt;&lt;b&gt;client_id &amp;amp; client_secret&lt;/b&gt;&lt;/div&gt;" vertex="1">
