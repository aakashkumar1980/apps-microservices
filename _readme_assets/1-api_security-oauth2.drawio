        <mxCell id="apigw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingLeft=15;spacingRight=10;align=left;spacingTop=10;fontSize=12;fontFamily=Times New Roman;" value="&lt;b&gt;🚪 AWS API Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;Public Endpoint&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Features:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;• JWT Authorizer (Okta)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Validates token signature &amp;amp; expiry&lt;br&gt;&amp;nbsp;&amp;nbsp;Rejects invalid tokens before hitting backend&lt;br&gt;&lt;br&gt;&lt;b&gt;• Throttling &amp;amp; Rate Limiting&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Limits requests per second per client&lt;br&gt;&amp;nbsp;&amp;nbsp;Prevents API abuse &amp;amp; DDoS attacks&lt;br&gt;&lt;br&gt;&lt;b&gt;• AWS WAF Protection&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Blocks SQL injection, XSS attacks&lt;br&gt;&amp;nbsp;&amp;nbsp;IP whitelisting/blacklisting rules&lt;br&gt;&lt;br&gt;&lt;b&gt;• API Keys &amp;amp; Usage Plans&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Track usage per client/partner&lt;br&gt;&amp;nbsp;&amp;nbsp;Enforce quota limits (e.g., 10K calls/day)&lt;br&gt;&lt;br&gt;&lt;b&gt;• Request/Response Logging&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;CloudWatch integration for audit&lt;br&gt;&amp;nbsp;&amp;nbsp;Debug &amp;amp; troubleshoot API issues" vertex="1">
          <mxGeometry height="400" width="260" x="600" y="200" as="geometry" />
