        <mxCell id="U_-UutNZe616P4BHMWC0-4" connectable="0" parent="U_-UutNZe616P4BHMWC0-3" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];textShadow=1;labelBackgroundColor=none;labelBorderColor=#666666;fontStyle=0;fontColor=#666666;" value="&lt;span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Step 3: Validate JWT (and cache)&lt;br&gt;&lt;br&gt;&lt;b&gt;REQUEST -&amp;gt;&lt;/b&gt;&lt;br&gt;GET https://&amp;lt;companyName&amp;gt;.okta.com/oauth2/default/v1/keys&lt;br&gt;&lt;br&gt;&lt;b&gt;RESPONSE -&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;{&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; &quot;keys&quot;: [&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; &amp;nbsp; {&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;kty&quot;: &quot;RSA&quot;,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;alg&quot;: &quot;RS256&quot;,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;kid&quot;: &quot;JWT-KEY-1&quot;,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;use&quot;: &quot;sig&quot;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;n&quot;: &quot;xxxxx&quot;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;e&quot;: &quot;AQAB&quot;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; &amp;nbsp; }&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp; ]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;}&lt;/span&gt;&lt;/div&gt;" vertex="1">
