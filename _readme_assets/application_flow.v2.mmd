---
config:
  flowchart:
    curve: stepAfter
  layout: dagre
---
flowchart LR
  subgraph Client["Clients"]
    C1["Cardlytics<br>Okta Token call"]
    C2["Cardlytics<br>REST API call"]
  end
  subgraph OAuth2["OAuth2"]
    O1["Okta Identity Provider<br> create token"]
    O2["Okta Identity Provider<br> validate token"]
  end
subgraph MS["Offer Write Service<br>https:_//$companyName.privateUrl.com/api_endpoint (e.g. /api/v1/offers)"]
BLANK["&nbsp;&nbsp;<br>&nbsp;<br>&nbsp;"]
CTRL@{ label: "@RestController<br>@RequestMapping('/api')<br>Controller<br><br>@PostMapping('/offers')<br>@PreAuthorize('hasAuthority(SCOPE_offer:create)')<br>+ createOffer(@Valid Offer offer)" }
SVC@{ label: "<div style=\"text-align:left; width:460px;\">@Service<br>Service<br><br>+ createOffer(Offer offer)<br>  - campaignValidation(offer.getCampaignId())<br>  - merchantValidation(offer.getMerchantId())<br>  - budgetValidation(campaign.getBudget(), offer.getDiscount())</div>" }
REPO["Repository"]
end
subgraph validations["validations"]
CRS@{ label: "Campaign Read Service<br>https:_//$companyName.privateUrl.com/api_endpoint (e.g. GET /api/v1/campaigns)<br><br>@GetMapping('$campaignId')<br>+ getCampaignById(String campaignId)" }
MRS@{ label: "Merchant Read Service<br>https:_//$companyName.privateUrl.com/api_endpoint (e.g. GET /api/v1/merchants)<br><br>@GetMapping('$merchantId')<br>+ getMerchantById(String merchantId)" }
end
subgraph saga["SAGA (Transaction Rollback)"]
OWS_COMPENSATE@{ label: "<div style=\"width:400px;\">@RestController<br>Offer Write Service<br>https:_//$companyName.privateUrl.com/api_endpoint (e.g. /api/v1/offers)<br><br>@PostMapping('cancel/$offerId')<br>+ cancelOffer(String offerId)</div>" }
KAFKA_CANCELLED[/"Kafka<br>Topic: OFFER_CANCELLED"/]
DB_OFFER2[("Offer Documents (Compensation)")]
DB_MERCHANT2[("Merchant Documents (Compensation)")]
DB_CUSTOMER2[("Customer Documents (Compensation)")]
MWSC@{ label: "<div style=\"text-align:left; width:400px;\">@Service<br>Merchant Write Service<br><br>@KafkaListener(topics='OFFER_CANCELLED')<br>+ subscribeOfferCancelledEvent(OfferCancelledEvent e)</div>" }
CWSC@{ label: "<div style=\"text-align:left; width:400px;\">@Service<br>Customer Write Service<br><br>@KafkaListener(topics='OFFER_CANCELLED')<br>+ subscribeOfferCancelledEvent(OfferCancelledEvent e)</div>" }
end
KAFKA_CANCELLED -- Subscribe --> MWSC & CWSC
MWSC -- Update Merchant (compensate) --> DB_MERCHANT2
CWSC -- Update Customer (compensate) --> DB_CUSTOMER2
C1 -- "1- Request Token<br>https:_//$companyName.okta.com/oauth2/token clientId, client_secret, scope='offer:create, ...'" --> O1
C2 -- "2- GET/POST call<br>https:_//$companyName.publicUrl.com/api_endpoint<br>Header: Authorization: Bearer $token" --> AG@{ label: "<div style=\"text-align:left; width:400px;\"><b>API Gateway</b><br>https:_//$companyName.publicUrl.com<br><br>- converts private url to public url<br>- protects url via. oauth2 security<br>- protects server against DDoS, SQL Injection attacks<br>- reduces load by Caching" }
AG -. "3- Validate Token" .-> O2
AG -- "4- Forward Request" --> CTRL
CTRL -- "5- Process Request" --> SVC
SVC -- "6a- RestTemplate API call" --> CRS
SVC -- "6b- RestTemplate API call" --> MRS
SVC -- "7- Save Offer Document" --> REPO
REPO --> DB_OFFER[("Offer Documents")]
SVC -- "8- Publish Kafka Event" --> KAFKA[/"Kafka<br>Topic: OFFER_CREATED"/]
KAFKA -- Subscribe --> CWS@{ label: "<div style=\"text-align:left; width:400px;\">@Service<br>Campaign Write Service<br><br>@KafkaListener(topics='OFFER_CREATED')<br>+ subscribeOfferCreatedEvent(OfferCreatedEvent e)</div>" } & MWS@{ label: "<div style=\"text-align:left; width:400px;\">@Service<br>Merchant Write Service<br><br>@KafkaListener(topics='OFFER_CREATED')<br>+ subscribeOfferCreatedEvent(OfferCreatedEvent e)</div>" } & CUWS@{ label: "<div style=\"text-align:left; width:400px;\">@Service<br>Customer Write Service<br><br>@KafkaListener(topics='OFFER_CREATED')<br>+ subscribeOfferCreatedEvent(OfferCreatedEvent e)</div>" }
CWS -- Update Campaign --> DB_CAMPAIGN[("Campaign Documents")]
CWS -. On Failure<br>RestTemplate API call .-> OWS_COMPENSATE
OWS_COMPENSATE -- Publish Event --> KAFKA_CANCELLED
MWS -- Update Merchant --> DB_MERCHANT[("Merchant Documents")]
CUWS -- Update Customer --> DB_CUSTOMER[("Customer Documents")]
OWS_COMPENSATE -- Update Offer --> DB_OFFER2
n1["Text Block"]
