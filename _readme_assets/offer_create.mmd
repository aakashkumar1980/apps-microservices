MES["OfferEventSubscriber<br>- subscribeCreateOfferEvent()"]:::subscriber
MC["MerchantCommandService<br>- linkOfferToMerchant()"]:::service
end

%% Customer Subscriber
subgraph Customer_Write_Microservice
