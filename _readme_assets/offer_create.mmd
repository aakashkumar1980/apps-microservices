flowchart TD

%% REST Client
    POSTMAN["POST /offers
    <div style='text-align: left'>
{
#emsp; name: '',
#emsp; description: '',
#emsp; status: 'ACTIVE',
#emsp; type: 'DISCOUNT',
#emsp; <font color=orange><b> discount_amount</b></font>: 100,
#emsp; currency: 'USD',
#emsp; valid_from: '2025-07-15T00:00:00',
#emsp; valid_to: '2025-08-07T00:00:00',
#emsp; segment_criteria: 'GOLD',
#emsp; <font color=orange><b>campaign_id</b></font>: '',
#emsp; <font color=orange><b>merchant_id</b></font>: ''
}
</div>
"]:::external

%% Offer Write Microservice
subgraph Offer_Write_Microservice
style Offer_Write_Microservice fill:#FFF9C4,stroke:#333,stroke-width:1px

OCC["OfferCommandController<br>- createOffer()"]:::controller
OCS["OfferCommandService<br>- createOffer()"]:::service

CV["CampaignValidation :: <b>validateCampaign()</b><i>
<div style='text-align: left'>
basedto(campaign)
{
#emsp; ...,
#emsp; data: {
#emsp;#emsp; <font color=blue><b>status</b></font>: 'PAUSED',
#emsp;#emsp; <font color=blue><b>end_date</b></font>: '2025-08-12T00:00:00'
#emsp; }
}<br>
- first checks if the <font color=orange><b>campaign_id</b> EXISTS</font> in the Redis Cache or gets it from the REST API (using @CacheUtils).<br>
- if found, it validates the campaign <font color=blue><b>status</b>=ACTIVE and <b>end_date</b> NOT PASSED</font>.<br>
- else, throw RequestValidationException.
</div>
</i>"]:::service

MV["MerchantValidation :: <b>validateMerchant()</b><i>
<div style='text-align: left'>
- first checks if the <font color=orange><b>merchant_id</b> EXISTS</font> in the Redis Cache or gets it from the REST API (using @CacheUtils).<br>
- else, throw RequestValidationException.
</div>
"]:::service

OV["OfferValidation :: <b>validateCampaignBudgetNotExceeded()</b><i>
<div style='text-align: left'>
basedto(campaign)
{
#emsp; ...,
#emsp; data: {
#emsp;#emsp; <font color=blue><b>budget</b></font>: 1000
#emsp; }
}<br>
validates that the campaign budget has not been exceeded by the offers.<br>
- fetch the campaign's <font color=blue><b>budget</b></font> from the Redis Cache or gets it from the REST API (using @CacheUtils).<br>
- fetch all offers associated for the specified <font color=orange><b>campaign_id</b></font> (using @ApiUtils) and then SUM their <font color=orange><b>discount_amount</b></font> i.e. [{discount_amout=300}, {[{discount_amout=500}, ..].<br>
- finally, compare the offer's TOTAL discount_amount with the campaign's budget and throws RequestValidationException if exceeded.
</div>
"]:::service

OCR["OfferCommandRepository<br>- save()"]:::repository
OEP["OfferEventPublisher<br>- publishCreateOfferEvent()"]:::event
end

%% Merchant Subscriber
subgraph Merchant_Write_Microservice
