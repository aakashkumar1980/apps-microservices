  CCS["CampaignCommandService<br> - linkOfferToCampaign()
    <div style='text-align:left; font-style:italic;'>
      <div style='background-color:rgb(252, 251, 240); width:300px;'>
        basedto(campaign).json
        {
        #emsp; ...,
        #emsp; data: {
        #emsp;#emsp; <font color=navy><b>offer_ids</b></font>: [
        #emsp;#emsp; ]
        #emsp; }
        }<br>
      </div>
      LINK OFFER
      - fetch the campaign for the <font color=orange><b>campaign_id</b></font> from the REST API (using @ApiUtils)<br>
      - add the new <font color=red>offer <b>id</b></font> in the <font color=navy><b>offer_ids</b></font> list of the merchant.
    </div>
  "]:::service
end

COUCHBASE_CAMPAIGN[("Couchbase DB<br>(bucket: campaign)")]:::db

%% Flow Steps (Campaign Write Flow)
KAFKA1 --> CAS
CAS -->|1: delegate to service| CCS
