flowchart TD
%% --- Campaign Write Microservice ---
    subgraph subGraph4["Campaign Write Microservice"]
        direction TB
        c1["CampaignCommandController.createCampaign()<br/><i>Receives the API request to create a campaign</i>"]
        s1["CampaignCommandService.createCampaign()<br/><i>Handles business logic for creating a campaign</i>"]
        r1["CampaignCommandRepository.save()<br/><i>Saves the campaign data to the database</i>"]
        e1["CampaignEventPublisher.publishCreateCampaignEvent()<br/><i>Publishes an event after campaign creation</i>"]
    end

%% --- Offer Write Microservice ---
    subgraph subGraph7["Offer Write Microservice"]
        direction TB
        oesub["CampaignEventSubscriber.subscribeCreateCampaignEvent()<br/><i>Listens for campaign creation events</i>"]
    end

%% --- External Systems ---
postman["REST API"]
couchbase["Couchbase DB"]
kafka["Kafka"]
redis["Redis Cache"]

%% --- Flow for Create Campaign ---
postman -- "1: POST /api/campaigns" --> c1
c1 -- "2: Delegate to service" --> s1
s1 -- "3: Save campaign" --> r1
r1 -- "4: Persist to Couchbase" --> couchbase
s1 -- "5: Publish event" --> e1
e1 -- "6: CAMPAIGN_CREATED event" --> kafka
kafka -- "7: Event consumed" --> oesub
oesub -- "8: Update Redis cache" --> redis

%% --- Styling ---
postman:::ext
couchbase:::ext
kafka:::ext
redis:::ext
classDef ext fill:#fff,stroke:#333,stroke-width:2px
style subGraph4 fill:#BBDEFB
style subGraph7 fill:#C8E6C9
