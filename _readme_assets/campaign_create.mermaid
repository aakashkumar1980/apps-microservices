flowchart TD
%% Postman
    POSTMAN["Postman<br>POST /api/campaigns"]:::external

%% Microservice: Campaign Write
    subgraph Campaign_Write_Microservice
        style Campaign_Write_Microservice fill:#BBDEFB,stroke:#333,stroke-width:1px

        CCC["CampaignCommandController<br>createCampaign()"]:::controller
        CCS["CampaignCommandService<br>createCampaign()"]:::service
        DBU["DBUtils<br>getUniqueCounter()"]:::util
        CCR["CampaignCommandRepository<br>save()"]:::repository
        CEP["CampaignEventPublisher<br>publishCreateCampaignEvent()"]:::event
    end

%% Microservice: Offer Write
    subgraph Offer_Write_Microservice
        style Offer_Write_Microservice fill:#FFF9C4,stroke:#333,stroke-width:1px

        CES["CampaignEventSubscriber<br>onCampaignCreated()"]:::subscriber
        OCU["CacheUtils<br>put()"]:::util2
    end

%% External: Couchbase
    CB1["Couchbase<br>campaign::123"]:::external
%% External: Redis
    REDIS["Redis Cache<br>Campaign Data"]:::external
%% External: Kafka
    K1["Kafka Topic<br>CAMPAIGN_CREATED"]:::external

%% Flow Arrows
    POSTMAN -->|1: Send request<br>to create campaign| CCC
    CCC -->|2: Accept request<br>map to service| CCS
    CCS -->|3: Wrap into DTO<br>with metadata| DBU
    DBU -->|4: Generate unique ID<br>like campaign::123| CB1
    CCS -->|5: Save DTO<br>using repository| CCR
    CCR -->|6: Persist to Couchbase| CB1
    CCS -->|7: Publish creation event<br>to Kafka| CEP
    CEP -->|8: Send to Kafka Topic| K1
    K1 -->|9: Kafka event received<br>CAMPAIGN_CREATED| CES
    CES -->|10: Process event<br>in offer microservice| OCU
    OCU -->|11: Cache campaign<br>data to Redis| REDIS

%% Styling
    classDef controller fill:#E3F2FD,stroke:#1E88E5,color:#000;
    classDef service fill:#E8F5E9,stroke:#43A047,color:#000;
    classDef repository fill:#F3E5F5,stroke:#8E24AA,color:#000;
    classDef util fill:#FFF3E0,stroke:#FB8C00,color:#000;
    classDef event fill:#E0F7FA,stroke:#00ACC1,color:#000;
    classDef subscriber fill:#F1F8E9,stroke:#7CB342,color:#000;
    classDef util2 fill:#FBE9E7,stroke:#D84315,color:#000;
    classDef external fill:#FFFFFF,stroke:#000,color:#000,stroke-dasharray: 4 2;
