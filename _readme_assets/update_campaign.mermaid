---
config:
  layout: dagre
---
flowchart TD
    subgraph subGraph4["Campaign Write Microservice"]
        direction TB
        c1["CampaignCommandController _updateCampaign()"]
        v1["CampaignValidation _keepOriginalOfferIds()"]
        u1["APIUtils _fetchAndCacheBaseDtoById()"]
        s1["CampaignCommandService _updateCampaign()"]
        r1["CampaignCommandRepository _save()"]
        e1["CampaignEventPublisher _publishUpdateCampaignEvent()"]
    end
    subgraph subGraph5["Campaign Read Microservice"]
        direction TB
        cr1["CampaignQueryController _getCampaignById()"]
        crs1["CampaignQueryService _getCampaignById()"]
        crr1["CampaignQueryRepository _findById()"]
    end
    subgraph subGraph7["Offer Write Microservice"]
        direction TB
        oesub["CampaignEventSubscriber _subscribeUpdateCampaignEvent()"]
    end
    postman["REST API"] -- 1: PUT /api/campaigns --> c1
    c1 -- 2: Validate & keep original offer IDs --> v1
    v1 -- 3: Calls APIUtils to fetch campaign by ID --> u1
    u1 -- 4: Calls GET /api/campaigns/{id} --> cr1
cr1 --> crs1
crs1 --> crr1
crr1 --> couchbase["Couchbase DB"]
v1 -- 5: Set original offer IDs --> s1
s1 -- 6: Save updated campaign --> r1
r1 -- 7: Persist to Couchbase --> couchbase
s1 -- 8: Publish update event --> e1
e1 -- 9: CAMPAIGN_UPDATED event --> kafka["Kafka"]
kafka -- 10: Event consumed --> oesub
oesub -- 11: Update Redis cache --> redis["Redis Cache"]
postman@{ img: "https://cdn-icons-png.flaticon.com/128/718/718064.png", h: 32, w: 32, constraint: "on"}
couchbase@{ img: "https://cdn-icons-png.flaticon.com/128/9850/9850812.png", h: 32, w: 32, constraint: "on"}
kafka@{ img: "https://cdn-icons-png.flaticon.com/128/16177/16177677.png", h: 32, w: 32, constraint: "on"}
redis@{ img: "https://cdn-icons-png.flaticon.com/128/18279/18279795.png", h: 32, w: 32, constraint: "on"}
postman:::ext
couchbase:::ext
kafka:::ext
redis:::ext
classDef ext fill:#fff,stroke:#333,stroke-width:2px
style subGraph4 fill:#BBDEFB
style subGraph5 fill:#BBDEFB
style subGraph7 fill:#C8E6C9
