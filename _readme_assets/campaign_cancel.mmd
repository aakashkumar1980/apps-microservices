    </div>
  "]:::service

  COEP["CustomerOfferEventPublisher<br> - publishOfferDisenrollmentEvent()"]:::event
end

COUCHBASE_CUSTOMER_SUB[("Couchbase DB<br>(bucket: customer)")]:::db

KAFKA_COD[["kafka topic: CUSTOMER_OFFER_DISENROLLED
  <div style='text-align:left; background-color:#fcf3f0; width:180px;'>
    event(offerdisenrollmentevent).json
    {
      #emsp; <font color=red><b>offerId</b>:''</font>,
      #emsp; <font color=orange><b>customerIds</b></font>:[
      #emsp;]
    }
  </div>
"]]:::kafka

%% Flow Steps (Customer Write Flow)
KAFKA_OC --> CES
CES -->|1: delegate to service| CC
CC -->|2: update data model| COUCHBASE_CUSTOMER_SUB
CC -->|3: publish event| COEP
COEP -->|4: send to kafka topic| KAFKA_COD



