---
config:
  layout: dagre
---
flowchart TD
    subgraph Campaign_Write_Microservice["Campaign_Write_Microservice"]
        CCC["CampaignCommandController<br>updateCampaign()"]
        CCS["CampaignCommandService<br>updateCampaign()"]
        VAL["CampaignValidation<br>keepOriginalOfferIds()"]
        APIU["APIUtils<br>fetchAndCacheBaseDtoById()"]
        CCR["CampaignCommandRepository<br>save()"]
        CEP["CampaignEventPublisher<br>publishUpdateCampaignEvent()"]
    end
    subgraph Offer_Write_Microservice["Offer_Write_Microservice"]
        CES["OfferEventSubscriber<br>onCampaignUpdated()"]
        CU2["CacheUtils<br>put()"]
    end
    subgraph REST_Campaign_Read_API["GET /api/campaigns/:id"]
        REST["REST API<br>Campaign Read Service"]
    end
    POSTMAN["Postman<br>PUT /api/campaigns/:id"] -- 1: PUT request<br>to update campaign --> CCC
    CCC -- 2: Pass to service --> CCS
    CCS -- 3: Validate linkedOffers --> VAL
    VAL -- 4: Fetch original campaign --> APIU
    APIU -- "5: No - Call REST API" --> REST
    APIU -- 6: Set linkedOffers from original --> VAL
    CCS -- 7: Save campaign --> CCR
    CCR -- 8: Write to Couchbase --> CB1["Couchbase<br>campaign document"]
    CCS -- 9: Publish Kafka event --> CEP
    CEP -- 10: Send to topic CAMPAIGN_UPDATED --> K1["Kafka Topic<br>CAMPAIGN_UPDATED"]
    K1 -- 11: Receive update event --> CES
    CES -- 12: Process in Offer MS --> CU2
    CU2 -- 13: Cache updated campaign --> REDIS2["Redis Cache<br>updated campaign"]
    CCC:::controller
    CCS:::service
    VAL:::validator
    APIU:::util
    CCR:::repository
    CEP:::event
    CES:::subscriber
    CU2:::util2
    REST:::external
    POSTMAN:::external
    CB1:::external
    K1:::external
    REDIS2:::external
    classDef controller fill:#E3F2FD,stroke:#1E88E5,color:#000
    classDef service fill:#E8F5E9,stroke:#43A047,color:#000
    classDef validator fill:#EDE7F6,stroke:#5E35B1,color:#000
    classDef repository fill:#F3E5F5,stroke:#8E24AA,color:#000
    classDef util fill:#FFF3E0,stroke:#FB8C00,color:#000
    classDef event fill:#E0F7FA,stroke:#00ACC1,color:#000
    classDef subscriber fill:#F1F8E9,stroke:#7CB342,color:#000
    classDef util2 fill:#FBE9E7,stroke:#D84315,color:#000
    classDef external fill:#FFFFFF,stroke:#000,color:#000,stroke-dasharray: 4 2
    style Campaign_Write_Microservice fill:#BBDEFB,stroke:#333,stroke-width:1px
    style Offer_Write_Microservice fill:#FFF9C4,stroke:#333,stroke-width:1px
    style REST_Campaign_Read_API stroke-dasharray: 4 4,fill:#ffffff
