flowchart TD

%% --- 3rd Party Services (no icon for GET) ---
postmanPut["PUT /api/campaigns/cancel"]
getCampaign["GET /api/campaigns/{id}"]
redisO1["Offer Redis Cache 1"]
redisO2["Offer Redis Cache 2"]
redisM1["Merchant Redis Cache"]
redisC1["Customer Redis Cache"]
couchCamp["Campaign Couchbase DB"]
couchOffer["Offer Couchbase DB"]
couchMerch["Merchant Couchbase DB"]
couchCustomer["Customer Couchbase DB"]
kafkaCancel["Kafka (CAMPAIGN_CANCELLED)"]
kafkaOfferCancel["Kafka (OFFER_CANCELLED)"]

%% --- Campaign Write Microservice ---
subgraph CampaignWriteMS["Campaign Write Microservice"]
c1["CampaignCommandController.cancelCampaign()<br/><i>Handles cancel campaign API call</i>"]
cApi["APIUtils.fetchAndCacheBaseDtoById()<br/><i>Fetches campaign data by ID</i>"]
cCacheCheck{{"Cache Hit?"}}
cRepo["CampaignCommandRepository.save()<br/><i>Saves cancelled campaign</i>"]
cPub["CampaignEventPublisher.publishCancelCampaignEvent()<br/><i>Publishes campaign cancelled event</i>"]
end

%% --- Offer Write Microservice ---
subgraph OfferWriteMS["Offer Write Microservice"]
oSub["CampaignEventSubscriber.subscribeCancelCampaignEvent()<br/><i>Listens for campaign cancelled events</i>"]
oCacheDel["CacheUtils.delete()<br/><i>Removes campaign from cache</i>"]
oSrv["OfferCommandService.cancelOffers()<br/><i>Cancels related offers</i>"]
oRepo["OfferCommandRepository.save()<br/><i>Saves cancelled offers</i>"]
oPub["OfferEventPublisher.publishCancelOfferEvent()<br/><i>Publishes offer cancelled event</i>"]
end

%% --- Customer Write Microservice ---
subgraph CustomerWriteMS["Customer Write Microservice"]
custSub["OfferEventSubscriber.subscribeCancelOfferEvent()<br/><i>Listens for offer cancelled events</i>"]
custCacheDel["CacheUtils.delete()<br/><i>Removes offer from cache</i>"]
custSrv["CustomerCommandService.unassignOfferFromCustomer()<br/><i>Unassigns offer from customers</i>"]
custRepo["CustomerCommandRepository.save()<br/><i>Saves updated customers</i>"]
custPub["OfferCustomerEventPublisher.publishOfferUnassignedEvent()<br/><i>Publishes offer unassigned event</i>"]
end

%% --- Merchant Write Microservice ---
subgraph MerchantWriteMS["Merchant Write Microservice"]
mSub["OfferEventSubscriber.subscribeCancelOfferEvent()<br/><i>Listens for offer cancelled events</i>"]
mCacheDel["CacheUtils.delete()<br/><i>Removes offer from cache</i>"]
mSrv["MerchantCommandService.unlinkOfferFromMerchant()<br/><i>Unlinks offer from merchant</i>"]
mRepo["MerchantCommandRepository.save()<br/><i>Saves updated merchant</i>"]
end

%% --- Flow ---
postmanPut -- "1: Cancel campaign API call" --> c1
c1 -- "2: Fetch campaign" --> cApi
cApi -- "3: Check cache" --> cCacheCheck
cCacheCheck -- "4a: Hit" --> redisO1
cCacheCheck -- "4b: Miss" --> getCampaign
c1 -- "5: Save cancelled campaign" --> cRepo
cRepo -- "6: Write DB" --> couchCamp
c1 -- "7: Publish event" --> cPub
cPub -- "8: Send to Kafka" --> kafkaCancel

kafkaCancel -- "9: CAMPAIGN_CANCELLED" --> oSub
oSub -- "10: Remove campaign from cache" --> oCacheDel
oCacheDel --> redisO2
oSub -- "11: Cancel offers" --> oSrv
oSrv -- "12: Save cancelled offers" --> oRepo
oRepo -- "13: Write DB" --> couchOffer
oSrv -- "14: Publish OFFER_CANCELLED" --> oPub
oPub -- "15: Send to Kafka" --> kafkaOfferCancel

kafkaOfferCancel -- "16: OFFER_CANCELLED" --> custSub
custSub -- "17: Remove offer from cache" --> custCacheDel
custCacheDel --> redisC1
custSub -- "18: Unassign offer from customers" --> custSrv
custSrv -- "19: Save customers" --> custRepo
custRepo -- "20: Write DB" --> couchCustomer
custSrv -- "21: Publish unassigned event" --> custPub

kafkaOfferCancel -- "22: OFFER_CANCELLED" --> mSub
mSub -- "23: Remove offer from cache" --> mCacheDel
mCacheDel --> redisM1
mSub -- "24: Unlink offer from merchant" --> mSrv
mSrv -- "25: Save merchant" --> mRepo
mRepo -- "26: Write DB" --> couchMerch

%% --- Styling ---
classDef ext fill:#fff,stroke:#333,stroke-width:2px
classDef offerColor fill:#FFF9C4,stroke:#999
classDef campaignColor fill:#BBDEFB,stroke:#999
classDef merchantColor fill:#B2EBF2,stroke:#999
classDef customerColor fill:#C8E6C9,stroke:#999

class CampaignWriteMS campaignColor
class OfferWriteMS offerColor
class MerchantWriteMS merchantColor
class CustomerWriteMS customerColor